<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="#F0F0F0">

    <TextView
        android:id="@+id/pau_code_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="CONTAINER"/>

    <TextView
        android:id="@+id/pau_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="italic"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toEndOf="@id/pau_code_text"
        app:layout_constraintTop_toTopOf="parent"
        android:text="Assigned"/>

    <Button
        android:id="@+id/pau_assign_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="pau_Assign"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@+id/pau_release_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="pau_Release"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
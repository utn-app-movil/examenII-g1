<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/txtCreateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/marco_title_create_container"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <EditText
        android:id="@+id/edtContainerId"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/marco_hint_container_id" />

    <EditText
        android:id="@+id/edtProduct"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/marco_hint_product" />

    <Button
        android:id="@+id/btnCreateContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/marco_btn_create_container"
        android:layout_marginTop="16dp" />

    <ProgressBar
        android:id="@+id/progressCreateContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".pau_LoginActivity">

    <TextView
        android:id="@+id/pau_login_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Log in"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="64dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/pau_email_login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Email "
        android:inputType="textEmailAddress"
        android:padding="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/pau_login_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/pau_password_login"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/pau_email_login"
        app:layout_constraintStart_toStartOf="@id/pau_email_login"
        app:layout_constraintEnd_toEndOf="@id/pau_email_login" />

    <Button
        android:id="@+id/pau_login_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Log in"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/pau_password_login"
        app:layout_constraintStart_toStartOf="@id/pau_email_login"
        app:layout_constraintEnd_toEndOf="@id/pau_email_login" />

    <ProgressBar
        android:id="@+id/pau_progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/pau_login_button"
        app:layout_constraintBottom_toBottomOf="@id/pau_login_button"
        app:layout_constraintStart_toStartOf="@id/pau_login_button"
        app:layout_constraintEnd_toEndOf="@id/pau_login_button" />

</androidx.constraintlayout.widget.ConstraintLayout>
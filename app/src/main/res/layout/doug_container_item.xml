<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/doug_card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/doug_container_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Number: CONT-001"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/doug_container_size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size: 20"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/doug_container_number"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/doug_container_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Type: Dry"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/doug_container_size"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/doug_container_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Free"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/doug_container_type"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/doug_container_technician"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Technician: email@example.com"
            android:textSize="12sp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/doug_container_status"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/doug_action_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assign"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
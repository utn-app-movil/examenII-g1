<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <TextView
        android:id="@+id/txtContainerId"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="CRXXXX"
        android:textStyle="bold"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnAssign"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtProduct"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Producto: Food"
        app:layout_constraintStart_toStartOf="@id/txtContainerId"
        app:layout_constraintTop_toBottomOf="@id/txtContainerId" />

    <TextView
        android:id="@+id/txtTechnician"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Técnico: -"
        app:layout_constraintStart_toStartOf="@id/txtProduct"
        app:layout_constraintTop_toBottomOf="@id/txtProduct" />

    <TextView
        android:id="@+id/txtDate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Fecha: -"
        app:layout_constraintStart_toStartOf="@id/txtTechnician"
        app:layout_constraintTop_toBottomOf="@id/txtTechnician"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <Button
        android:id="@+id/btnAssign"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btnAssign"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnRelease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btnRelease"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnAssign" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="cr.ac.utn.appmovil.containers">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Restapi">
        <activity
            android:name="Caleb.UI.AllContainersActivity"
            android:exported="false" />
        <activity
            android:name="Caleb.UI.CreateContainerActivity"
            android:exported="false" />
        <activity
            android:name="Caleb.UI.menuCaleb"
            android:exported="false" />
        <activity
            android:name="Caleb.UI.LoginActivityCaleb"
            android:exported="false" />
        <activity
            android:name="cr.ac.utn.appmovil.containers.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>